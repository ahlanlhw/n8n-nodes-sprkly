						"type": "main",
						"index": 0
					}
				]
			]
		},
		"OpenAI model": {
			"ai_languageModel": [
				[
					{
						"node": "Write the summary",
						"type": "ai_languageModel",
						"index": 0
					}
				]
			]
		},
		"Write the summary": {
			"main": [
				[
