				"text": "=Topic: {{ $json.Topic }}",
				"hasOutputParser": true,
				"messages": {
					"messageValues": [
						{
							"message": "You write social media posts for a small business. Write two captions about the topic. \"short\": under 260 characters, for X, Threads and Bluesky, no hashtags. \"long\": 600 to 1200 characters, for LinkedIn, Facebook and Instagram, short paragraphs, end with a question. Plain words. Do not make up facts, prices or numbers."
						}
					]
				},
				"batching": {}
			}
		},
