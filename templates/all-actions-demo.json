				},
				"event": "postFailed"
			}
		},
		{
			"id": "f816dc7a-6f88-4212-b0c3-fd7788f67974",
			"name": "Failed: what you get",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				240,
				960
			],
			"parameters": {
