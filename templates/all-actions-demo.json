			"parameters": {
				"resource": "post",
				"operation": "delete",
				"postId": "={{ $('Create a post').first().json.postId }}"
			},
			"executeOnce": true
		},
		{
			"id": "384be6d7-0286-44e0-948f-8e1fce51277a",
			"name": "On post published",
			"type": "n8n-nodes-sprkly.sprklyTrigger",
			"typeVersion": 1,
			"position": [
				0,
