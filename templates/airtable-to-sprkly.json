			},
			"onError": "continueErrorOutput"
		},
		{
			"id": "59e06a95-fb2e-4437-a5c3-280d06a01163",
			"name": "Schedule post for approval",
			"type": "n8n-nodes-sprkly.sprkly",
			"typeVersion": 1.1,
			"position": [
				560,
				320
			],
			"parameters": {
				"resource": "post",
				"operation": "create",
				"accountMode": "name",
				"accountNames": "={{ [].concat($('Get Ready records').item.json.Accounts || []).join(', ') }}",
				"caption": "={{ $('Get Ready records').item.json.Caption }}",
				"scheduledTime": "={{ $('Get Ready records').item.json['Publish Time'] }}",
				"mediaIds": "={{ $json.mediaId || '' }}",
				"output": "resultRow",
				"additionalFields": {
					"externalId": "={{ 'airtable-' + $('Get Ready records').item.json.id }}",
					"mediaUrls": "={{ $('Get Ready records').item.json['Media URL'] || '' }}",
					"requireExternalId": true,
					"requiresApproval": true,
					"approvalNote": "={{ $('Get Ready records').item.json['Approval Note'] || '' }}"
				}
			}
		},
