				"returnAll": true,
				"options": {}
			}
		},
		{
			"id": "20967f50-11a5-42d6-a1fe-411223cc6fe7",
			"name": "Has a file?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				80,
				320
			],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "loose",
						"version": 2
					},
					"conditions": [
						{
							"id": "has-file",
							"leftValue": "={{ ($json.Media || []).length }}",
							"rightValue": 0,
							"operator": {
								"type": "number",
								"operation": "gt"
							}
						}
					],
					"combinator": "and"
				},
				"looseTypeValidation": true,
				"options": {}
			}
		},
		{
			"id": "f5c33512-5b10-44c1-ba2d-b88f749aeb47",
